#!/bin/sh
# <!-- installed-by:tldraw-desktop-agent-skills -->
# tq — tldraw canvas-api helper. Usage:
#   sh tq GET  /api/doc/DOC/script-status
#   sh tq POST /api/search '{"code":"return await api.getDocs()"}'                # JSON body
#   sh tq POST /api/doc/DOC/exec 'return editor.getCurrentPageShapes().length'    # raw JS body
set -e
[ "$#" -ge 2 ] && [ "$#" -le 3 ] || { echo 'Usage: sh tq <GET|POST> </api/path> [body]' >&2; exit 2; }
case "$1" in GET|POST) ;; *) echo "tq: unsupported method: $1" >&2; exit 2 ;; esac
sj=${TLDRAW_STATE_FILE:-"$HOME/Library/Application Support/tldraw/server.json"}
[ -f "$sj" ] || { echo "tq: tldraw is not running (missing $sj)" >&2; exit 1; }
port=$(jq -er '.port | select(type == "number")' "$sj") || { echo "tq: invalid port in $sj" >&2; exit 1; }
token=$(jq -er '.token | select(type == "string" and length > 0)' "$sj") || { echo "tq: invalid token in $sj" >&2; exit 1; }
case "$port" in ''|*[!0-9]*) echo "tq: invalid port in $sj" >&2; exit 1 ;; esac
[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || { echo "tq: invalid port in $sj" >&2; exit 1; }
url="http://localhost:$port$2"
if [ -z "$3" ]; then
  printf 'authorization: Bearer %s\n' "$token" | curl -s -X "$1" "$url" -H @-
else
  body=$(printf '%s' "$3" | sed 's/^[[:space:]]*//')
  case "$body" in
    '{'*|'['*) ctype='content-type: application/json' ;;
    *)         ctype='content-type: text/plain' ;;
  esac
  printf 'authorization: Bearer %s\n' "$token" | curl -s -X "$1" "$url" -H @- -H "$ctype" --data-binary "$3"
fi
