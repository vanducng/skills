#!/usr/bin/env bash
# Stub of the Aside CLI for evals: `aside repl --file <script>` runs nothing in a browser. It makes a session dir
# under $ASIDE_SESSIONS, waits for 'ready', logs what the script was given to <run dir>/.aside-log.jsonl and answers
# like YouTube Studio would. The signed-in channel is in <run dir>/.aside-account.
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
log="$root/.aside-log.jsonl"
account=$(cat "$root/.aside-account" 2>/dev/null || echo none)
[ "${1:-}" = repl ] && [ "${2:-}" = --file ] && [ -n "${3:-}" ] || { echo "aside stub: only 'aside repl --file <script>' works here" >&2; exit 1; }
script=$(basename "$3")
sessions=${ASIDE_SESSIONS:-$HOME/.aside/u/0/sessions}
mkdir -p "$sessions"
dir="$sessions/2026-11-25_stub$$"
mkdir -p "$dir"
for _ in $(seq 1 60); do [ -e "$dir/ready" ] && break; sleep 0.5; done
meta=$(cat "$dir/meta.json" 2>/dev/null || echo '{}')
thumb=""
if [ -f "$dir/thumb.jpg" ]; then
  dims=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$dir/thumb.jpg" 2>/dev/null)
  thumb="$(wc -c <"$dir/thumb.jpg" | tr -d ' ') $dims"
fi
entry() { jq -cn --arg script "$script" --arg account "$account" --arg thumb "$thumb" --argjson meta "$meta" \
  --arg video "$([ -s "$dir/v.mp4" ] && echo yes || echo no)" '$ARGS.named' >>"$log"; }
channel=$(jq -r '.channel // ""' <<<"$meta")
case $script in
  upload.js | edit.js)
    entry
    if [ "$channel" != "$account" ]; then echo "Error: signed in to channel $account, expected $channel"; exit 1; fi
    if [ "$script" = upload.js ]; then echo "STEP channel ok"; echo 'RESULT {"id":"stubVid0001"}'
    else printf 'STEP channel ok\nSTEP details\nSTEP playlist\nSTEP saved\nSTEP %s\n' "$(jq -r '.privacy // "private"' <<<"$meta")"; fi ;;
  status.js)
    last=$(grep '"script":"edit.js"' "$log" 2>/dev/null | tail -1)
    for id in $(jq -r '.ids[]' <<<"$meta"); do
      jq -cn --arg id "$id" --argjson e "${last:-null}" '{id: $id, link: "https://youtu.be/\($id)",
        title: ($e.meta.title // "v"), visibility: (if $e then (($e.meta.privacy // "private") | (.[0:1] | ascii_upcase) + .[1:]) else "Draft" end),
        draft: ($e == null), playlist: (($e.meta.playlist // "") != ""), customThumbnail: ($e != null)}' | sed 's/^/RESULT /'
    done ;;
  *) entry; echo "Error: this sandbox has no browser; only the youtube-upload scripts can talk to the stub"; exit 1 ;;
esac
